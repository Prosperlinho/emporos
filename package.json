{
  "name": "emporos",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A Celo procurement agent that restocks small-shop inventory and pays suppliers in cNGN.",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types lib/*.test.ts",
    "cli:build": "tsc -p tsconfig.cli.json",
    "procure": "npm run cli:build && node --env-file-if-exists=.env dist/index.js procure",
    "register": "npm run cli:build && node --env-file-if-exists=.env dist/index.js register"
  },
  "dependencies": {
    "@celo/attribution-tags": "0.5.0",
    "@rainbow-me/rainbowkit": "^2.2.11",
    "@supabase/supabase-js": "^2.119.2",
    "@tanstack/react-query": "^5.90.0",
    "dotenv": "^17.2.3",
    "next": "^16.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "viem": "^2.58.3",
    "wagmi": "^2.19.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.3"
  }
}
