# Required before any mainnet transaction. Obtain your actual assigned code from
# the hackathon; do not treat this example or a derived code as an assigned code.
ATTRIBUTION_CODE=

# Dedicated procurement/registration wallet. Keep this key private and never commit it.
PROCUREMENT_PRIVATE_KEY=

# Public registration-v1 document URL used by `npm run register`.
AGENT_URI=

# Optional. viem's Celo public RPC is used when this is unset.
CELO_RPC_URL=

# Set to "mainnet" only after funding and approving the buy wallet. Defaults to Sepolia.
BUY_RESEARCH_NETWORK=sandbox

# Mainnet x402 settlements currently cannot carry ERC-8021 tags on Celo.
# Set to "1" only if you explicitly accept that limitation.
ALLOW_UNTAGGED_X402=
