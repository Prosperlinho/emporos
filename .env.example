# ── Web app (Next.js) ───────────────────────────────────────────────────────────
# Copy to .env.local for `npm run dev`, and add the same keys in Vercel → Settings → Environment Variables.

# Attribution code assigned to this project. Every Emporos-signed transaction (swap, approve,
# supplier transfer, agent revoke sweep, ERC-8004 registration) carries it as an ERC-8021 suffix.
# Live payments are blocked while this is empty.
NEXT_PUBLIC_ATTRIBUTION_CODE=

# cNGN token contract on Celo mainnet. There is deliberately no default: more than one token
# uses the "cNGN" ticker. Get the address from the issuer's developer docs, confirm it on Celoscan.
NEXT_PUBLIC_CNGN_ADDRESS=

# Tether USD₮ on Celo. Defaults to 0x48065fbBE25f71C9282ddf5e1cD6D6A887483D5e; verify before funding.
NEXT_PUBLIC_USDT_ADDRESS=

# Optional Celo RPC. Defaults to the public Forno endpoint.
NEXT_PUBLIC_CELO_RPC_URL=

# WalletConnect Cloud project ID. Without it only injected wallets (MiniPay, extension wallets) connect.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Supabase: accounts, suppliers, products, orders. Without these the app runs in demo mode only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# LLM request parsing: any OpenAI-compatible chat completions API (server-side only).
# Examples: https://api.openai.com/v1 · https://api.groq.com/openai/v1 · https://openrouter.ai/api/v1
# Without a key, a rule-based parser is used.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# FX for USD₮ → cNGN top-ups. "textile" is a placeholder until Textile's API is integrated;
# "0x" uses the 0x Swap API (needs ZEROX_API_KEY). With neither, swaps are disabled and
# shops pay from an existing cNGN balance.
FX_PROVIDER=
ZEROX_API_KEY=
# Indicative rate shown in demo mode only (cNGN per USD₮).
FX_DEMO_RATE=1450

# ── Legacy CLI (src/, `npm run procure` / `npm run register`) ─────────────────────
ATTRIBUTION_CODE=
PROCUREMENT_PRIVATE_KEY=
AGENT_URI=
CELO_RPC_URL=
BUY_RESEARCH_NETWORK=sandbox
ALLOW_UNTAGGED_X402=
